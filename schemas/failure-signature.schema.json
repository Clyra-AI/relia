{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/failure-signature.schema.json",
  "title": "Relia Failure Signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "signature_id",
    "class",
    "key",
    "extraction_confidence",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.failure_signature"
    },
    "schema_version": {
      "const": "1.0"
    },
    "signature_id": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "enum": ["test_failure", "lint_failure", "build_failure", "review_correction", "revert", "unknown"]
    },
    "check_name": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "message_fingerprint": {
      "type": "string"
    },
    "extraction_confidence": {
      "enum": ["structured", "log_parsed", "low"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
