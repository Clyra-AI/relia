{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/outcome-evidence.schema.json",
  "title": "Relia Outcome Evidence",
  "type": "object",
  "additionalProperties": false,
  "x-relia-exit-codes": [2, 4, 6, 9],
  "required": [
    "object_type",
    "schema_version",
    "evidence_id",
    "outcome_kind",
    "source",
    "redaction_status",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.outcome_evidence"
    },
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome_kind": {
      "enum": ["check_run", "revert", "review_correction", "merge", "manual_mark"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url"],
      "properties": {
        "provider": {
          "enum": ["github"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "redaction_status": {
      "enum": ["applied", "failed_closed"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
