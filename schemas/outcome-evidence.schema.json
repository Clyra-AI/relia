{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/outcome-evidence.schema.json",
  "title": "Relia Outcome Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "evidence_id", "source", "outcome_kind", "terminal_state", "provenance_refs", "redaction_status", "metadata"],
  "x-relia_error_mapping": {
    "invalid_input": 2,
    "artifact_validation": 4,
    "redaction_safety": 6,
    "provenance_integrity": 9
  },
  "properties": {
    "object_type": {"const": "relia.outcome_evidence"},
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["pull_request", "check_run", "revert", "review_correction"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "outcome_kind": {"enum": ["ci_failed", "reverted", "review_correction", "merged_clean", "fix_held"]},
    "terminal_state": {"enum": ["passed", "failed", "reverted", "corrected", "unknown"]},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "redaction_status": {"enum": ["applied", "failed_closed"]},
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relia_version"],
      "properties": {"relia_version": {"type": "string", "minLength": 1}}
    }
  }
}
