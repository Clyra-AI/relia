{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/outcome-evidence.schema.json",
  "title": "Relia Outcome Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "evidence_id",
    "kind",
    "source",
    "url",
    "observed_at",
    "redaction_status",
    "relia_version",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.outcome_evidence"
    },
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["pull_request", "check_run", "revert", "review_correction", "commit"]
    },
    "source": {
      "enum": ["github", "local_fixture", "manual_review"]
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "redaction_status": {
      "enum": ["applied", "failed_closed"]
    },
    "relia_version": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
