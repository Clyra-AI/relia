{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/experience-record.schema.json",
  "title": "Relia Experience Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "experience_id",
    "repo",
    "recorded_at",
    "attribution",
    "context",
    "action",
    "outcome",
    "provenance",
    "flake_discount",
    "org_eligible",
    "share_scope",
    "redaction_status",
    "relia_version",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.experience_record"
    },
    "schema_version": {
      "const": "1.0"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "org": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "attribution": {
      "$ref": "#/$defs/attribution"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "flake_discount": {
      "type": "boolean"
    },
    "org_eligible": {
      "const": false
    },
    "share_scope": {
      "const": "private"
    },
    "redaction_status": {
      "enum": ["applied", "failed_closed"]
    },
    "relia_version": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence"],
      "properties": {
        "method": {
          "enum": ["bot_login", "coauthor_trailer", "pr_label", "manual", "uncertain"]
        },
        "confidence": {
          "enum": ["high", "medium", "low", "uncertain"]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "diff_fingerprint"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diff_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "commits"],
      "properties": {
        "pr": {
          "type": "string",
          "minLength": 1
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "terminal_state", "signature"],
      "properties": {
        "kind": {
          "enum": ["ci_failure", "revert", "review_correction", "merge_clean", "fix_held"]
        },
        "terminal_state": {
          "enum": ["pass", "fail", "reverted", "corrected", "held"]
        },
        "signature": {
          "$ref": "failure-signature.schema.json"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
