{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/experience-record.schema.json",
  "title": "Relia Experience Record",
  "type": "object",
  "additionalProperties": false,
  "x-relia-exit-codes": [2, 4, 6, 9],
  "required": [
    "object_type",
    "schema_version",
    "experience_id",
    "repo",
    "recorded_at",
    "attribution",
    "context",
    "action",
    "outcome",
    "provenance",
    "flake_discount",
    "org_eligible",
    "share_scope",
    "redaction_status",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.experience_record"
    },
    "schema_version": {
      "const": "1.0"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "$ref": "#/$defs/repo_ref"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "attribution": {
      "$ref": "#/$defs/attribution"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "flake_discount": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "org": {
      "type": "string"
    },
    "org_eligible": {
      "const": false
    },
    "share_scope": {
      "const": "private"
    },
    "redaction_status": {
      "enum": ["applied", "failed_closed"]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "repo_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": {
          "enum": ["github"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_kind", "method", "confidence"],
      "properties": {
        "actor_kind": {
          "enum": ["agent", "human", "uncertain"]
        },
        "method": {
          "enum": ["bot_login", "coauthor_trailer", "pr_label", "manual", "uncertain"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "diff_fingerprint"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diff_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "commit"],
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "terminal_state", "signature"],
      "properties": {
        "kind": {
          "enum": ["merged_clean", "ci_failure", "revert", "review_correction", "fix_held"]
        },
        "terminal_state": {
          "enum": ["passed", "failed", "reverted", "corrected", "held"]
        },
        "signature": {
          "$ref": "#/$defs/signature_ref"
        }
      }
    },
    "signature_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_id", "extraction_confidence"],
      "properties": {
        "signature_id": {
          "type": "string",
          "minLength": 1
        },
        "extraction_confidence": {
          "enum": ["structured", "log_parsed_high", "log_parsed_low", "unknown"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
