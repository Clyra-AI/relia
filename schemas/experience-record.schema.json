{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/experience-record.schema.json",
  "title": "Relia Experience Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "experience_id",
    "repo",
    "recorded_at",
    "attribution",
    "context",
    "action",
    "outcome",
    "provenance",
    "flake_discount",
    "org_eligible",
    "share_scope",
    "redaction_status",
    "metadata"
  ],
  "x-relia_error_mapping": {
    "invalid_input": 2,
    "artifact_validation": 4,
    "redaction_safety": 6,
    "provenance_integrity": 9
  },
  "properties": {
    "object_type": {"const": "relia.experience_record"},
    "schema_version": {"const": "1.0"},
    "experience_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_authored", "method", "confidence"],
      "properties": {
        "agent_authored": {"type": "boolean"},
        "method": {"enum": ["bot_login", "coauthor_trailer", "pr_label", "manual", "unknown"]},
        "confidence": {"enum": ["high", "medium", "low", "uncertain"]},
        "actor_ref": {"type": "string"},
        "tool": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "diff_fingerprint"],
      "properties": {
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "diff_fingerprint": {"type": "string", "minLength": 1},
        "scope": {"type": "string"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "commits"],
      "properties": {
        "pr": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "minLength": 1}
          ]
        },
        "commits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "terminal", "signature"],
      "properties": {
        "kind": {"enum": ["ci_failure", "revert", "review_correction", "merge_clean", "fix_held"]},
        "terminal": {"enum": ["passed", "failed", "reverted", "corrected", "unknown"]},
        "signature": {"$ref": "#/$defs/signature_ref"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refs"],
      "properties": {
        "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance_ref"}}
      }
    },
    "flake_discount": {"type": "number", "minimum": 0, "maximum": 1},
    "org": {"type": "string"},
    "org_eligible": {"const": false},
    "share_scope": {"const": "private"},
    "redaction_status": {"enum": ["applied", "failed_closed"]},
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "$defs": {
    "signature_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "message_fingerprint", "extraction_confidence"],
      "anyOf": [
        {"required": ["signature_class"]},
        {"required": ["class"]}
      ],
      "properties": {
        "signature_id": {"type": "string", "minLength": 1},
        "signature_class": {"enum": ["test_failure", "lint_failure", "type_failure", "build_failure", "review_correction", "revert"]},
        "class": {"enum": ["test_failure", "lint_failure", "type_failure", "build_failure", "review_correction", "revert"]},
        "check_name": {"type": "string", "minLength": 1},
        "check": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "message_fingerprint": {"type": "string", "minLength": 1},
        "extraction_confidence": {"enum": ["structured", "log_parse_high", "log_parse_low", "high", "medium", "low"]}
      }
    },
    "provenance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {"enum": ["pull_request", "check_run", "commit", "review_comment"]},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relia_version"],
      "properties": {
        "relia_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
