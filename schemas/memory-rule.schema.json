{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/memory-rule.schema.json",
  "title": "Relia Memory Rule",
  "type": "object",
  "additionalProperties": false,
  "x-relia-exit-codes": [2, 4, 9],
  "required": [
    "object_type",
    "schema_version",
    "id",
    "kind",
    "status",
    "statement",
    "scope",
    "confidence",
    "evidence",
    "provenance",
    "review",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.memory_rule"
    },
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "<!-- relia:begin \\(generated; edit rules in memory/rules/, not here\\) -->"
          },
          {
            "pattern": "<!-- relia:end -->"
          }
        ]
      }
    },
    "kind": {
      "enum": ["avoid", "playbook"]
    },
    "status": {
      "enum": ["candidate", "active", "stale", "contradicted", "retired"]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["paths"],
          "properties": {
            "paths": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["signals"],
          "properties": {
            "signals": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "contradictions", "experiences"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "contradictions": {
          "type": "integer",
          "minimum": 0
        },
        "experiences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["pr", "outcome", "url"],
        "properties": {
          "pr": {
            "type": "integer",
            "minimum": 1
          },
          "outcome": {
            "enum": ["ci_failure", "revert", "review_correction", "fix_held", "merged_clean"]
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "statement_origin"],
      "properties": {
        "label": {
          "enum": ["accepted", "suggested", "needs_user_input"]
        },
        "gate": {
          "enum": ["human_review"]
        },
        "decision": {
          "enum": ["pending", "approved", "needs_user_input", "rejected", "merged"]
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "merged_into": {
          "type": "string",
          "minLength": 1
        },
        "statement_origin": {
          "enum": ["llm_drafted", "cluster_summary", "human_authored"]
        }
      }
    },
    "source_repo": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "confidence_label": {
          "enum": ["high", "medium", "low"]
        },
        "lifecycle_reason": {
          "type": "string"
        },
        "confidence_inputs": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "evidence_count": {
              "type": "integer",
              "minimum": 1
            },
            "recency_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "contradictions": {
              "type": "integer",
              "minimum": 0
            },
            "flake_discount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "extraction_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "drafting_model_weight": {
              "const": 0
            }
          }
        },
        "decay": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "half_life_days": {
              "type": "integer",
              "minimum": 1
            },
            "latest_evidence_at": {
              "type": "string",
              "format": "date-time"
            },
            "oldest_evidence_at": {
              "type": "string",
              "format": "date-time"
            },
            "anchor_recorded_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_artifact_digest": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "embedding_mode": {
          "type": "string"
        },
        "review_required": {
          "type": "boolean"
        },
        "serving_eligible": {
          "type": "boolean"
        },
        "deterministic_fallback": {
          "type": "boolean"
        },
        "memory_source": {
          "enum": ["verified_outcome_events"]
        },
        "source_record_type": {
          "const": "relia.experience_record"
        },
        "excluded_memory_sources": {
          "type": "array",
          "items": {
            "enum": ["agent_self_report", "agent_reflection"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "required": ["review"],
        "properties": {
          "review": {
            "required": ["label"],
            "properties": {
              "label": {
                "const": "accepted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status", "review"],
        "properties": {
          "status": {
            "const": "active"
          },
          "review": {
            "required": ["decision"]
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["review"],
        "properties": {
          "review": {
            "required": ["decision"],
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "required": ["status"],
        "properties": {
          "status": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "required": ["review"],
        "properties": {
          "review": {
            "required": ["decision"],
            "properties": {
              "decision": {
                "const": "merged"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": ["merged_into"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["review"],
        "properties": {
          "review": {
            "required": ["decision"],
            "properties": {
              "decision": {
                "enum": ["rejected", "merged"]
              }
            }
          }
        }
      },
      "then": {
        "required": ["status"],
        "properties": {
          "status": {
            "const": "retired"
          }
        }
      }
    },
    {
      "if": {
        "required": ["review"],
        "properties": {
          "review": {
            "required": ["label"],
            "properties": {
              "label": {
                "const": "accepted"
              }
            }
          }
        }
      },
      "then": {
        "required": ["status"],
        "properties": {
          "status": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "required": ["review"],
        "properties": {
          "review": {
            "required": ["statement_origin"],
            "properties": {
              "statement_origin": {
                "enum": ["llm_drafted", "cluster_summary"]
              }
            }
          }
        }
      },
      "then": {
        "required": ["metadata"],
        "properties": {
          "metadata": {
            "required": ["confidence_label", "confidence_inputs", "decay"],
            "properties": {
              "confidence_inputs": {
                "required": [
                  "evidence_count",
                  "recency_weight",
                  "contradictions",
                  "flake_discount",
                  "extraction_confidence",
                  "drafting_model_weight"
                ]
              },
              "decay": {
                "required": [
                  "half_life_days",
                  "latest_evidence_at",
                  "oldest_evidence_at",
                  "anchor_recorded_at"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
