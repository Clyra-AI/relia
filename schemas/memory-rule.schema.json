{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/memory-rule.schema.json",
  "title": "Relia Memory Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "rule_id",
    "kind",
    "status",
    "statement",
    "confidence",
    "evidence",
    "provenance",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.memory_rule"
    },
    "schema_version": {
      "const": "1.0"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["avoid", "playbook"]
    },
    "status": {
      "enum": ["candidate", "active", "stale", "contradicted", "retired"]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experience_id"],
        "properties": {
          "experience_id": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": {
            "enum": ["pull_request", "check_run", "review_comment", "commit", "revert"]
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_label": {
      "enum": ["accepted", "suggested", "needs_user_input"]
    },
    "source_repo": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
