{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/memory-rule.schema.json",
  "title": "Relia Memory Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "rule_id",
    "kind",
    "status",
    "statement",
    "confidence",
    "scope",
    "evidence",
    "provenance",
    "redaction_status",
    "relia_version",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.memory_rule"
    },
    "schema_version": {
      "const": "1.0"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["avoid", "playbook"]
    },
    "status": {
      "enum": ["candidate", "active", "stale", "contradicted", "retired"]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_label": {
      "enum": ["accepted", "suggested", "needs_user_input"]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "source_repo": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance_ref"
      }
    },
    "redaction_status": {
      "enum": ["applied", "failed_closed"]
    },
    "relia_version": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["review_label"]
      }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience_id", "outcome_kind"],
      "properties": {
        "experience_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome_kind": {
          "enum": ["ci_failed", "merged_clean", "reverted", "review_corrected", "fix_held"]
        }
      }
    },
    "provenance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
