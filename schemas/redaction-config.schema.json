{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/redaction-config.schema.json",
  "title": "Relia Redaction Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "patterns",
    "entropy_scan",
    "fail_closed",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.redaction_config"
    },
    "schema_version": {
      "const": "1.0"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entropy_scan": {
      "type": "boolean"
    },
    "fail_closed": {
      "const": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
