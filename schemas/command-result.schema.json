{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/command-result.schema.json",
  "title": "Relia Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "command",
    "status",
    "mode",
    "exit_code",
    "warnings",
    "errors",
    "artifacts",
    "evidence_refs",
    "duration_ms",
    "redaction_status",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.command_result"
    },
    "schema_version": {
      "const": "1.0"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["pass", "error"]
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command_error"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "redaction_status": {
      "enum": ["not_applicable", "applied", "failed_closed"]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "data": {
      "type": "object"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relia_version", "schema_ref", "schema_version"],
      "properties": {
        "relia_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "command_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message", "exit_code"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "remediation": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
