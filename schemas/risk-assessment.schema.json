{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clyra-AI/relia/schemas/risk-assessment.schema.json",
  "title": "Relia Risk Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "assessment_id",
    "status",
    "risk_level",
    "matched_rules",
    "unknown_paths",
    "redaction_status",
    "metadata"
  ],
  "properties": {
    "object_type": {
      "const": "relia.risk_assessment"
    },
    "schema_version": {
      "const": "1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["pass", "warn", "gate_failed"]
    },
    "risk_level": {
      "enum": ["none", "low", "medium", "high"]
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "confidence"],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "unknown_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction_status": {
      "enum": ["applied", "failed_closed", "not_applicable"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
