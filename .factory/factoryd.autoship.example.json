{
  "factory": {
    "repo_path": "${FACTORY_REPO}",
    "profile_path": ".factory/profile.yaml"
  },
  "repos": {
    "relia": {
      "repo_path": "..",
      "default_branch": "main",
      "artifact_root": ".factory/artifacts",
      "acceptance_ledger": ".factory/artifacts/prd-to-plan/relia-mvp/acceptance-ledger.json",
      "task_packets": ".factory/artifacts/prd-to-plan/relia-mvp/task-packets.json",
      "scope_closure_map": ".factory/artifacts/prd-to-plan/relia-mvp/scope-closure-map.json",
      "validation_contract": ".factory/artifacts/prd-to-plan/relia-mvp/validation-contract.json",
      "validation_commands": [
        "python3 scripts/validate_repo_pack.py"
      ],
      "state_dir": "../.factoryd",
      "workspace_root": "../.factoryd/workspaces",
      "branch_prefix": "codex",
      "worker_type": "codex_cli",
      "worker_command": "",
      "runtime_control": {
        "owner": "factoryd-operator",
        "autonomy_level": "restricted",
        "mission_paused": false,
        "mission_canceled": false,
        "disabled_adapters": [],
        "max_write_scope_paths": [],
        "release_freeze": {
          "enabled": false,
          "reason": "",
          "exception_ref": ""
        },
        "launch_request": {
          "requested_action": "continue_mission",
          "requested_adapter": "codex-cli",
          "expected_decision": "allow",
          "reason_code": "within_runtime_control_limits"
        },
        "conflict_behavior": "fail_closed"
      },
      "queue": {
        "backend": "file",
        "index_path": "../.factoryd/queue/index.json",
        "sync_command": "",
        "sync_required": false
      },
      "budget": {
        "max_worker_tokens": 0,
        "max_worker_cost_usd": 0,
        "max_run_seconds": 0
      },
      "architecture_budget": {
        "enabled": true,
        "policy_ref": "https://github.com/Clyra-AI/factory/blob/main/docs/standards/architecture-fitness-standard.md#default-budget",
        "warn_line_threshold": 1200,
        "fail_line_threshold": 2500,
        "source_extensions": [".go", ".py", ".ts", ".tsx", ".js", ".jsx"],
        "excluded_dirs": [".git", ".factoryd", ".factory/tmp", ".relia", "workspaces", ".venv", "__pycache__", "build", "dist", "node_modules", "vendor"],
        "exception_refs": [".factory/artifacts/exceptions/architecture-debt-relia-main.json"]
      },
      "command_timeout_seconds": 300,
      "worker_timeout_seconds": 1800,
      "lease_ttl_seconds": 14400,
      "mode": "until_blocked",
      "auto_ship": true,
      "shipping": {
        "enabled": true,
        "provider": "github_cli",
        "skip_commit": false,
        "commit_message": "factoryd: complete {task_id}",
        "merge_method": "squash",
        "scope_closure_mode": "semantic",
        "push_required": true,
        "pr_required": true,
        "ci_required": true,
        "codex_review_required": true,
        "merge_required": true,
        "post_merge_required": true,
        "scope_closure_required": true,
        "push_command": "",
        "open_pr_command": "",
        "ci_command": "",
        "codex_review_command": "",
        "merge_command": "",
        "post_merge_command": "",
        "scope_closure_command": "",
        "phase_timeout_seconds": {
          "ci": 5400,
          "codex_review": 5400,
          "merge": 1800,
          "post_merge": 1800
        }
      },
      "approval_posture": "human approval required for live credentials and high-risk work; merge allowed only by explicit task-scoped merge_authority grant",
      "credential_posture": "no ambient secrets during deterministic bootstrap",
      "network_posture": "offline by default until approved",
      "capability_grants": []
    }
  }
}
