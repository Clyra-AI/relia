{
  "factory": {
    "repo_path": "${FACTORY_REPO}",
    "profile_path": ".factory/profile.yaml"
  },
  "repos": {
    "relia": {
      "repo_path": "..",
      "default_branch": "main",
      "artifact_root": ".factory/artifacts",
      "acceptance_ledger": ".factory/artifacts/post-prd/behavior-version-control/acceptance-ledger.json",
      "task_packets": ".factory/artifacts/post-prd/behavior-version-control/task-packets.json",
      "scope_closure_map": ".factory/artifacts/post-prd/behavior-version-control/scope-closure-map.json",
      "validation_contract": ".factory/artifacts/post-prd/behavior-version-control/validation-contract.json",
      "runtime_control_ref": "",
      "runtime_control": {
        "owner": "factoryd-operator",
        "autonomy_level": "restricted",
        "release_freeze": {
          "enabled": false
        },
        "launch_request": {
          "requested_action": "continue_mission",
          "requested_adapter": "codex-cli",
          "expected_decision": "allow",
          "reason_code": "within_runtime_control_limits"
        },
        "conflict_behavior": "fail_closed"
      },
      "validation_commands": [
        "python3 scripts/validate_repo_pack.py"
      ],
      "state_dir": "../.factoryd",
      "workspace_root": "../.factoryd/workspaces",
      "branch_prefix": "codex",
      "worker_type": "codex_cli",
      "worker_command": "",
      "approval_posture": "human approval required for live credentials, high-risk tasks, and merge",
      "credential_posture": "no ambient secrets during deterministic bootstrap",
      "network_posture": "offline by default until approved",
      "capability_grants": [],
      "model_routing": {
        "registry_ref": "docs/standards/model-routing-standard.md"
      },
      "sovereignty": {
        "mode": "restricted",
        "allowed_modes": [
          "restricted",
          "local_only"
        ],
        "data_boundary": "repo-local deterministic artifacts only",
        "credential_boundary": "no ambient secrets"
      },
      "feedback_graph_ref": ".factory/artifacts/lifecycle-signal-feedback-graph.json",
      "queue": {
        "backend": "file",
        "index_path": "../.factoryd/queue/index.json",
        "sync_command": "",
        "sync_required": false
      },
      "budget": {
        "max_worker_tokens": 0,
        "max_worker_cost_usd": 0,
        "max_run_seconds": 0
      },
      "architecture_budget": {
        "enabled": true,
        "policy_ref": "https://github.com/Clyra-AI/factory/blob/main/docs/standards/architecture-fitness-standard.md#default-budget",
        "warn_line_threshold": 1200,
        "fail_line_threshold": 2500,
        "source_extensions": [
          ".go",
          ".py",
          ".ts",
          ".tsx",
          ".js",
          ".jsx"
        ],
        "excluded_dirs": [
          ".git",
          ".factoryd",
          ".factory/tmp",
          ".relia",
          "workspaces",
          ".venv",
          "__pycache__",
          "build",
          "dist",
          "node_modules",
          "vendor"
        ],
        "exception_refs": [
          ".factory/artifacts/exceptions/architecture-debt-relia-main.json"
        ]
      },
      "verifier": {
        "command": "",
        "required": false,
        "independence_level": "",
        "timeout_seconds": 0
      },
      "repair_loop": {
        "max_attempts": 0,
        "stop_on_repeated_failure_fingerprint": false,
        "max_repeated_failure_fingerprint": 0,
        "require_explicit_retry_budget": false
      },
      "review_churn": {
        "max_repeated_fingerprint": 0,
        "max_non_convergent_rounds": 0
      },
      "mode": "until_blocked",
      "auto_ship": false,
      "shipping": {
        "enabled": false,
        "provider": "",
        "skip_commit": false,
        "commit_message": "factoryd: complete {task_id}",
        "merge_method": "squash",
        "scope_closure_mode": "semantic",
        "push_command": "",
        "open_pr_command": "",
        "ci_command": "",
        "codex_review_command": "",
        "merge_command": "",
        "post_merge_command": "",
        "scope_closure_command": "",
        "push_required": false,
        "pr_required": false,
        "ci_required": false,
        "codex_review_required": false,
        "merge_required": false,
        "post_merge_required": false,
        "scope_closure_required": false
      },
      "command_timeout_seconds": 300,
      "worker_timeout_seconds": 1800,
      "lease_ttl_seconds": 3600
    }
  }
}
